APP_NAME=multiplayer-game
SPRING_PROFILES_ACTIVE=local

SERVER_PORT=8080

POSTGRES_DB=game
POSTGRES_USER=game
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=game
RABBITMQ_PASSWORD=change-me

MINIO_ROOT_USER=replace-with-local-minio-admin-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-admin-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PRIVATE_BUCKET=titancore-private
OBJECT_STORAGE_PUBLIC_BUCKET=titancore-published
OBJECT_STORAGE_ACCESS_KEY=replace-with-application-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-application-secret-key
OBJECT_STORAGE_PATH_STYLE=true
ASSET_PUBLIC_BASE_URL=http://localhost:9000/titancore-published

JWT_ISSUER=multiplayer-game
JWT_ACCESS_SECRET=replace-with-at-least-32-bytes
JWT_REFRESH_SECRET=replace-with-at-least-32-bytes

CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
